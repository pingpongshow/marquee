node_modules/
.DS_Store
# Built web client (embedded into the server at build time)
server/internal/web/dist/*
!server/internal/web/dist/.gitkeep
# Local deploy secrets
deploy/.env
*.db
*.db-shm
*.db-wal

# The web client is TypeScript only. Compiled .js next to sources would shadow them
# (Vite resolves .js before .tsx), so never commit any.
web/src/**/*.js
web/*.tsbuildinfo

# Apple: the Xcode project is generated from apple/project.yml (xcodegen)
apple/Marquee.xcodeproj/
apple/**/.build/
apple/**/.swiftpm/
apple/**/xcuserdata/
apple/build/
apple/Vendor/

# Local end-to-end test environment (scripts/e2e/setup.sh): media, database, tokens
.e2e/

# Private planning notes (removed from the repository 2026-10-11)
docs/

# Local Docker Compose data (deploy/.env points here by default)
deploy/config/
deploy/models/
deploy/recordings/
deploy/empty-music/
deploy/empty-plex/

# Agent worktrees (local only)
.claude/worktrees/

# A server binary built in place (go build in server/)
/server/marquee
