node_modules/
.DS_Store
# Built web client (embedded into the server at build time)
server/internal/web/dist/*
!server/internal/web/dist/.gitkeep
# Local deploy secrets
deploy/.env
*.db
*.db-shm
*.db-wal

# The web client is TypeScript only. Compiled .js next to sources would shadow them
# (Vite resolves .js before .tsx), so never commit any.
web/src/**/*.js
web/*.tsbuildinfo

# Apple: the Xcode project is generated from apple/project.yml (xcodegen)
apple/Marquee.xcodeproj/
apple/**/.build/
apple/**/.swiftpm/
apple/**/xcuserdata/
apple/build/
apple/Vendor/
