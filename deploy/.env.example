# Copy to .env next to compose.yaml and adjust.
MARQUEE_VERSION=latest
# The user and group that own your media folders (id -u / id -g).
PUID=1000
PGID=1000
TZ=UTC

# Where Marquee keeps its database, settings, artwork cache and backups.
CONFIG_DIR=./config
# Your media. Video holds movies, shows, anime and home videos (one subfolder each).
VIDEO_DIR=/path/to/video
MUSIC_DIR=/path/to/music
# Read-only by default. Set to empty (VIDEO_MODE=) to let Library Health move unwanted
# duplicate files to a recoverable trash folder.
VIDEO_MODE=:ro
# Live TV recordings (must be writable).
RECORDINGS_DIR=./recordings
# Optional: a Plex Media Server data folder ("Plex Media Server" directory) to import from.
# PLEX_DIR=/path/to/plex/Library/Application Support/Plex Media Server
# Soundprint model cache (about 1.5 GB, downloaded on first start).
MODELS_DIR=./models
# RAM for transcoding scratch space.
TRANSCODE_SIZE=8g
# Intel Quick Sync only (compose.intel.yaml): the group owning /dev/dri/renderD128.
# RENDER_GID=109
MARQUEE_LOG_LEVEL=info
